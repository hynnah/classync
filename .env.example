# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=3000

# MySQL connection.
# Local dev (XAMPP default — root user, no password, start MySQL from the XAMPP control
# panel first, then create a `classync` database via phpMyAdmin or the mysql CLI):
DATABASE_URL=mysql://root:@127.0.0.1:3306/classync
# Deployment target is the school server (or Clever Cloud fallback) — see docs/CLASYNC_MASTER_PLAN.md §13

# Session cookie signing secret — any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# Google OAuth — from Google Cloud Console, see docs/CLASYNC_MASTER_PLAN.md §13
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Encryption key for Google Calendar refresh/access tokens at rest — `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=

# When true, /auth lets Playwright/dev log in as a seeded test user without going through
# Google's real consent screen. MUST be false (or unset) in production — see docs §7.
TEST_AUTH_BYPASS=false
