# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=3000

# MySQL connection.
# Local dev (XAMPP default — root user, no password, start MySQL from the XAMPP control
# panel first, then create a `classync` database via phpMyAdmin or the mysql CLI):
DATABASE_URL=mysql://root:@127.0.0.1:3306/classync
# Deployment target: TiDB Serverless (MySQL-compatible, free tier, no rewrite needed) +
# Vercel. Get the connection string from the TiDB Cloud console's "Connect" panel, e.g.
# DATABASE_URL=mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/classync

# TiDB Serverless (and most managed MySQL hosts) require TLS — local dev's plain MySQL
# does not support it, so this must stay false there. Set to true only for a host that
# actually requires TLS.
DATABASE_SSL=false

# Session cookie signing secret — any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# Google OAuth — from Google Cloud Console, see docs/CLASYNC_MASTER_PLAN.md §13
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# A second, separately-registered redirect URI for the Day 7 incremental
# Google Calendar consent step — must also be added under "Authorized redirect
# URIs" in the same Google Cloud Console OAuth client as the one above.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/calendar/connect/callback

# Encryption key for Google Calendar refresh/access tokens at rest — `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=

# When true, /auth lets Playwright/dev log in as a seeded test user without going through
# Google's real consent screen. MUST be false (or unset) in production — see docs §7.
TEST_AUTH_BYPASS=false
